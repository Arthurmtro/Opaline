              "description": "Popovers, cards, inputs, menus."
            },
            "hover": {
              "$ref": "#/$defs/color",
              "description": "Hovered rows and buttons."
            },
            "highlight": {
              "$ref": "#/$defs/color",
              "description": "Raised highlights: your own messages in Claude Code, active rows."
            },
            "selection": {
              "$ref": "#/$defs/color",
              "description": "Selected text and selected list items. Text must stay readable on it."
            },
            "border": {
              "$ref": "#/$defs/color",
              "description": "Visible borders and dividers."
            },
            "borderSubtle": {
              "$ref": "#/$defs/color",
              "description": "Faint separators and indent guides."
            },
            "accentSoft": {
              "$ref": "#/$defs/color",
              "description": "Lighter accent for secondary highlights and suggestions."
            },
            "accentDeep": {
              "$ref": "#/$defs/color",
              "description": "Darker accent: primary button fill, focused input border."
            },
            "accentDim": {
              "$ref": "#/$defs/color",
              "description": "Very muted accent: inactive focus, guides."
            },
            "textMuted": {
              "$ref": "#/$defs/color",
              "description": "Secondary text. At least 4.5:1 contrast on base."
            },
            "textSubtle": {
              "$ref": "#/$defs/color",
              "description": "Placeholders and hints."
            },
            "textFaint": {
              "$ref": "#/$defs/color",
              "description": "Disabled text and line numbers."
            },
            "success": {
              "$ref": "#/$defs/color",
              "description": "Additions and passing checks (green family)."
            },
            "warning": {
              "$ref": "#/$defs/color",
              "description": "Warnings and modified files (yellow or orange family)."
            },
            "error": {
              "$ref": "#/$defs/color",
              "description": "Errors and deletions (red family)."
            },
            "info": {
              "$ref": "#/$defs/color",
              "description": "Informational badges and renamed files."
            }
          },
          "description": "Interface color roles, from background to foreground."
        },
        "terminal": {
          "type": "object",
          "properties": {
            "ansi": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/color"
              },
              "minItems": 16,
              "maxItems": 16,
              "description": "16 ANSI colors: black, red, green, yellow, blue, magenta, cyan, white, then the bright variants in the same order."
            }
          }
        },
