              "description": "Function and method names, links."
            },
            "type": {
              "$ref": "#/$defs/color",
              "description": "Types, classes, attributes."
            },
            "string": {
              "$ref": "#/$defs/color",
              "description": "String literals."
            },
            "number": {
              "$ref": "#/$defs/color",
              "description": "Numbers, booleans, constants."
            },
            "comment": {
              "$ref": "#/$defs/color",
              "description": "Comments, rendered italic. The quietest role."
            },
            "property": {
              "$ref": "#/$defs/color",
              "description": "Object properties."
            },
            "variable": {
              "$ref": "#/$defs/color",
              "description": "Variables."
            },
            "special": {
              "$ref": "#/$defs/color",
              "description": "Labels, preprocessor, regex, special variables."
            },
            "operator": {
              "$ref": "#/$defs/color",
              "description": "Operators."
            },
            "punctuation": {
              "$ref": "#/$defs/color",
              "description": "Brackets and delimiters."
            }
          },
          "description": "Code highlighting roles."
        },
        "backdrop": {
          "type": "object",
          "properties": {
            "glow": {
              "$ref": "#/$defs/color",
              "description": "Glow rising from the bottom-right corner of the terminal and of web pages."
            },
            "glowStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Glow intensity at the corner. 0.1 to 0.25 reads well."
            },
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 8,
              "description": "Film grain strength in 8-bit levels. 0 disables it."
            },
            "webHue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "Hue that GitHub's blue-grey palette is rotated to."
            }
          }
        },
        "browser": {
          "type": "object",
          "properties": {
            "colors": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/color"
              },
              "minItems": 1,
